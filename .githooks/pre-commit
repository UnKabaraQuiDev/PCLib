#!/usr/bin/env bash

echo "Running Checkstyle & Spotless..."

mapfile -d '' -t staged_files < <(git diff --cached --name-only -z)

mvn initialize checkstyle:check spotless:apply
status=$?

if ((${#staged_files[@]})); then
    git add -- "${staged_files[@]}"
fi

if ((status != 0)); then
    echo "Spotless/checkstyle failed. Commit aborted."
    exit "$status"
fi
